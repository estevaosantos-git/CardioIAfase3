  {
    "id": "cardiohistorico",
    "type": "function",
    "z": "cardiofluxo",
    "name": "Últimas 60 amostras",
    "x": 430,
    "y": 280,
    "wires": [
      [
        "cardiojson"
      ]
    ],
    "outputs": 1,
    "func": "msg.payload = {agora: Date.now(), pontos: flow.get(\"pontos\") || []};\nreturn msg;"
  },
  {
    "id": "cardiojson",
    "type": "http response",
    "z": "cardiofluxo",
    "name": "Dados do painel",
    "x": 680,
    "y": 280,
    "wires": [],
    "headers": {
      "content-type": "application/json",
      "cache-control": "no-store"
    }
  }
]